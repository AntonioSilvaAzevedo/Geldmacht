NEXT_PUBLIC_API_URL=https://geldmacht-api-production.up.railway.app
NEXTAUTH_URL=https://geldmacht.com

# Versão mínima de sessão. Ao publicar uma versão nova que exija que os
# usuários façam login novamente, defina aqui o número da versão (mesmo da
# `package.json`). Sessões emitidas em versões anteriores serão deslogadas
# automaticamente. Deixe vazio/comente para não forçar relogin.
NEXT_PUBLIC_MIN_AUTH_VERSION=0.4.0
